# Docker Compose defaults to PostgreSQL. Override all four values together
# when changing credentials. Local runs may keep SQLite instead.
POSTGRES_DB=helpflow
POSTGRES_USER=helpflow
POSTGRES_PASSWORD=helpflow
DATABASE_URL=postgresql+psycopg://helpflow:helpflow@db:5432/helpflow
# Use "rules" for a fully local deterministic fallback without Ollama calls.
AI_PROVIDER=ollama
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=90
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
