# Docker Compose defaults to PostgreSQL. Override all four values together
# when changing credentials. Local runs may keep SQLite instead.
POSTGRES_DB=helpflow
POSTGRES_USER=helpflow
POSTGRES_PASSWORD=helpflow
DATABASE_URL=postgresql+psycopg://helpflow:helpflow@db:5432/helpflow
AI_PROVIDER=ollama
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=90
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
APP_PUBLIC_URL=http://localhost:5173
SESSION_COOKIE_NAME=helpflow_session
COOKIE_SECURE=false
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HelpFlow
