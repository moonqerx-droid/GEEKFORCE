# --- Application ---
APP_NAME=GEEKFORCE HelpFlow
APP_ENV=development
LOG_LEVEL=info

# --- Backend (apps/api) ---
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/helpflow.db

# --- AI ---
# mock | openai
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Incident Radar ---
INCIDENT_SIMILARITY_THRESHOLD=0.78

# --- Frontend ---
# Адрес API для apps/web и apps/operator
VITE_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
