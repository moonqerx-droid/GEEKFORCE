# Base URL of the backend API. Leave empty for same-origin deployments.
# Local Vite forwards /api and /health to port 8000 on any frontend port.
VITE_API_BASE_URL=

# Ollama may legally work for up to 90 seconds; mutations wait 100 seconds so
# the backend has time to return its deterministic fallback.
VITE_MUTATION_TIMEOUT_MS=100000

# Set to "true" to show a hidden dev panel with the raw Conversation JSON
# (playbook_id, confidence, technical step codes). Never enable in production.
VITE_SHOW_DEBUG=false

# One-click demo accounts on the login page outside `npm run dev` (demo builds only, never production).
VITE_SHOW_DEMO_LOGINS=false
