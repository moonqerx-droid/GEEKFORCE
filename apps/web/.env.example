# Base URL of the backend API. Leave empty for same-origin deployments.
# Local Vite forwards /api and /health to port 8000 on any frontend port.
VITE_API_BASE_URL=

# Set to "true" to show a hidden dev panel with the raw Conversation JSON
# (playbook_id, confidence, technical step codes). Never enable in production.
VITE_SHOW_DEBUG=false
